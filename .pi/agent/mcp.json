{
  "settings": {
    "toolPrefix": "none",
    "showStatusIcon": false,
    "mcpFooterStatus": "compact",
    "scriptMode": false,
    "freezeDirectTools": true
  },
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--extension"],
      "env": {
        "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "/Applications/Brave Origin Nightly.app/Contents/MacOS/Brave Origin Nightly",
        "PWTEST_EXTENSION_USER_DATA_DIR": "/Users/nulladdict/Library/Application Support/BraveSoftware/Brave-Origin-Nightly"
      },
      "directTools": ["browser_run_code_unsafe"]
    },
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "directTools": true,
      "includeTools": ["web_search_exa", "web_fetch_exa"]
    },
    "figma": {
      "url": "https://mcp.figma.com/mcp",
      "auth": "oauth",
      "oauth": { "clientName": "Codex" },
      "exposeResources": true,
      "directTools": [
        "get_design_context",
        "get_screenshot",
        "download_assets",
        "get_metadata",
        "get_variable_defs"
      ]
    }
  }
}
